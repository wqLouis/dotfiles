{
 "label" : "lock",
 "action" : "swaylock -f -c1e1e2e",
 "text" : "Lock",
 "keybind" : "l"
}
{
 "label" : "hibernate",
 "action" : "systemctl hibernate",
 "text" : "Hibernate",
 "keybind" : "h"
}
{
 "label" : "logout",
 "action" : "if printenv HYPRLAND_INSTANCE_SIGNATURE >/dev/null; then hyprctl dispatch 'hl.dsp.exit()'; elif printenv SWAYSOCK >/dev/null; then swaymsg exit; else loginctl terminate-session $XDG_SESSION_ID; fi",
 "text" : "Logout",
 "keybind" : "e"
}
{
 "label" : "shutdown",
 "action" : "systemctl poweroff",
 "text" : "Shutdown",
 "keybind" : "s"
}
{
 "label" : "suspend",
 "action" : "systemctl suspend",
 "text" : "Suspend",
 "keybind" : "u"
}
{
 "label" : "reboot",
 "action" : "systemctl reboot",
 "text" : "Reboot",
 "keybind" : "r"
}
