// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"project_panel": {
  "dock": "left"
 },
 "outline_panel": {
  "dock": "left"
 },
 "collaboration_panel": {
  "dock": "left"
 },
 "agent": {
  "dock": "right",
  "favorite_models": [],
  "model_parameters": []
 },
 "git_panel": {
  "dock": "left"
 },
 "languages": {
		"C": {},
	},
	"diagnostics": {
		"inline": {
			"enabled": false,
		},
	},
	"inlay_hints": {
		"show_value_hints": true,
		"enabled": false,
	},
	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"buffer_line_height": "comfortable",
	"ui_font_family": ".ZedSans",
	"terminal": {
		"cursor_shape": "bar",
	},
	"disable_ai": true,
	"context_servers": {
		"mcp-server-context7": {
   "enabled": true,
			"settings": {
				"context7_api_key": "",
			},
		},
	},
	"agent_servers": {},
	"helix_mode": false,
	"icon_theme": "Colored Zed Icons Theme Dark",
	"base_keymap": "VSCode",
	"preview_tabs": {
		"enabled": false,
	},
	"cursor_shape": "bar",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"vim_mode": false,
	"ui_font_size": 16,
	"buffer_font_size": 16.0,
	"theme": {
		"mode": "dark",
		"light": "Gruvbox Light",
		"dark": "macOS Classic Dark",
	},
}
