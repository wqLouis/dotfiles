# Ghostty configuration — Catppuccin Mocha (universal theme)
# https://ghostty.org/docs/config

# ─── Fonts / Window ───────────────────────────────────────────────────
# font-family = "JetBrains Mono Nerd Font"
# font-size = 12

# background-opacity = 0.85

# custom-shader = ~/.config/ghostty/shaders/ghostty-shaders/bloom.glsl
# custom-shader = ~/.config/ghostty/shaders/ghostty-shaders/cursor_blaze.glsl

# ─── Catppuccin Mocha palette ─────────────────────────────────────────
# https://github.com/catppuccin/catppuccin

